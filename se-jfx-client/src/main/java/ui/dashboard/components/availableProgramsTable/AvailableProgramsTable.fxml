<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TitledPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Available Programs" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.dashboard.components.availableProgramsTable.AvailableProgramsTableController">
   <content>
      <VBox alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
         <children>
            <TableView fx:id="programsTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colProgramName" minWidth="50.0" prefWidth="100.0" text="Name" />
                <TableColumn fx:id="colUserUploaded" minWidth="50.0" prefWidth="80.0" text="User" />
                  <TableColumn fx:id="colNumInstructions" minWidth="50.0" prefWidth="90.0" text="Instructions" />
                  <TableColumn fx:id="colMaxDegree" minWidth="50.0" prefWidth="80.0" text="Max Deg." />
                  <TableColumn fx:id="colNumExecutions" minWidth="50.0" prefWidth="80.0" text="Executions" />
                  <TableColumn fx:id="colAverageCreditCost" minWidth="50.0" prefWidth="80.0" text="Avg Cost" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <Button fx:id="btnExecuteProgram" mnemonicParsing="false" onAction="#btnExecuteProgramClicked" text="Execute Program">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </content>
</TitledPane>
